# ========== КРИТИЧНЫЕ СЕКРЕТЫ (ЗАМЕНИТЬ В ПРОДЕ!) ==========
AURA_JWT_SECRET=dev-jwt-secret-CHANGE-IN-PRODUCTION
AURA_2FA_KEY=dev-2fa-key-CHANGE-IN-PRODUCTION
POSTGRES_PASSWORD=postgres

# ========== AI Service ==========
AURA_AI_TOKEN=shared-secret-cpp-ai-CHANGE-IN-PRODUCTION
AURA_LLM_PROVIDER=mock
# Для работы с реальным LLM раскомментируйте:
# OPENAI_API_KEY=sk-...
# AURA_LLM_MODEL=gpt-4

# ========== Database ==========
AURA_DATABASE_URL=postgresql://postgres:postgres@localhost/aura
PG_URI=postgresql://postgres:postgres@localhost/aura

# ========== Сеть ==========
AURA_HOST=0.0.0.0
AURA_PORT=9000
AURA_MAX_CONNECTIONS=1024

# ========== AI Service (Python) ==========
AURA_AI_URL=http://localhost:8000
AURA_MEMORY_BACKEND=postgres
AURA_RAG_MODE=auto
AURA_CORS_ORIGINS=http://localhost:9000

# ========== Почта: коды подтверждения и сброса пароля ==========
# smtp — настоящая отправка; log — только запись в лог (без кодов); dev — код в
# ответе API (только локальная разработка, вместе с AURA_DEV_MODE=1).
AURA_MAIL_DRIVER=smtp
AURA_SMTP_HOST=smtp.example.com
# 587 + starttls (по умолчанию) или 465 + tls; none — только локальный ретранслятор
AURA_SMTP_PORT=587
AURA_SMTP_TLS=starttls
AURA_SMTP_USER=
AURA_SMTP_PASSWORD=
AURA_SMTP_FROM=Aura <no-reply@example.com>
# AURA_SMTP_CA_FILE=/etc/ssl/certs/own-ca.pem

# ========== Push-уведомления ==========
AURA_PUSH_DRIVER=dev
# Для production через webhook:
# AURA_PUSH_DRIVER=webhook
# AURA_PUSH_WEBHOOK_URL=https://push-gateway.internal/push

# ========== Google OAuth (опционально) ==========
# AURA_GOOGLE_CLIENT_ID=
# AURA_GOOGLE_CLIENT_SECRET=

# ========== Rate Limiting ==========
AURA_MAX_LOGIN_ATTEMPTS=8
AURA_LOGIN_WINDOW=300

# ========== Логи ==========
AURA_LOG_LEVEL=info

# ========== E2E тесты (моки для CI) ==========
# AURA_E2E_GOOGLE_MOCK=1
# AURA_E2E_PUSH_MOCK=1
