# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# --- Telegram ---
# Токен бота от @BotFather (без него запустится только HTTP API для APK)
BOT_TOKEN=
# Контакт поддержки для /paysupport (обязателен для продажи цифровых товаров)
SUPPORT_CONTACT=

# --- База ---
# SQLite по умолчанию; позже — postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///aura.db

# --- LLM (OpenAI-совместимый API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 0 — если провайдер не поддерживает response_format=json_object
LLM_JSON_MODE=1

# --- Голос ---
# STT (Whisper-совместимый /audio/transcriptions); пустой STT_BASE_URL = OPENAI_BASE_URL
STT_MODEL=whisper-1
STT_BASE_URL=
# TTS для голосовых ответов в Telegram (/audio/speech); пусто — выключено
TTS_MODEL=
TTS_VOICE=alloy

# --- HTTP API для Android ---
API_HOST=0.0.0.0
API_PORT=8080

# --- Пуши в APK: путь к JSON сервисного аккаунта Firebase (FCM HTTP v1) ---
FCM_CREDENTIALS_FILE=

# --- Часовой пояс по умолчанию (IANA) ---
DEFAULT_TZ=Europe/Moscow

# --- Подписка ---
FREE_MESSAGES_PER_DAY=20
PREMIUM_MESSAGES_PER_DAY=500
PREMIUM_DAYS=30
PREMIUM_PRICE_RUB=399
# Цена в Telegram Stars (подберите эквивалент 399 ₽)
PREMIUM_PRICE_STARS=250
# TON: адрес кошелька для приёма и цена в TON; пусто — оплата TON выключена
TON_WALLET=
PREMIUM_PRICE_TON=
TONCENTER_URL=https://toncenter.com/api/v2
TONCENTER_API_KEY=
