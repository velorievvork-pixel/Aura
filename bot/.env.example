# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# Токен бота от @BotFather (обязателен для запуска бота)
BOT_TOKEN=

# База: SQLite по умолчанию; позже — postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///aura.db

# LLM (OpenAI-совместимый API): чат и извлечение памяти
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 0 — если провайдер не поддерживает response_format=json_object
LLM_JSON_MODE=1

# Часовой пояс по умолчанию (IANA), если пользователь не выбрал свой
DEFAULT_TZ=Europe/Moscow

# Бесплатный лимит сообщений в день — с этапа 6
FREE_MESSAGES_PER_DAY=20
