# Шаблон .env для docker-compose и локального запуска.
# Скопируйте в .env (он в .gitignore, в git не коммитить) и заполните секреты.
# Пустой секрет = compose откажется стартовать (${VAR:?} в docker-compose.yml).
#
# Генерация каждого секрета (hex — безопасно вставлять в URL БД):
#   openssl rand -hex 32
# Значения из документации/примеров не использовать: сервер отклоняет
# известные дефолтные секреты.

# ========== КРИТИЧНЫЕ СЕКРЕТЫ (обязательны) ==========
# Подпись JWT (C++-сервер)
AURA_JWT_SECRET=
# Ключ шифрования TOTP-секретов и токенов интеграций; после запуска не менять
AURA_2FA_KEY=
# Общий секрет C++-сервер <-> AI-сервис (заголовок X-Aura-Token).
# Без него AI-сервис отвечает 503 (fail closed).
AURA_AI_TOKEN=

# ========== PostgreSQL (docker-compose) ==========
# Суперпользователь postgres — только для инициализации/обслуживания
POSTGRES_PASSWORD=
# Роль aura_app (C++-сервер, только DML) и aura_ai (AI-сервис, только память);
# создаются deploy/postgres/20-app-roles.sh при первом старте пустого тома
AURA_DB_PASSWORD=
AURA_AI_DB_PASSWORD=

# ========== Режим разработки ==========
# AURA_DEV_MODE=1 — только локальная разработка (слабые/сгенерированные
# секреты, dev-почта с кодом в ответе API). В production НЕ задавать.
# AURA_DEV_MODE=1
# AURA_AI_INSECURE_DEV=1 — AI-сервис без AURA_AI_TOKEN (только localhost,
# make ai-run ставит его сам). В production НЕ задавать.
# AURA_AI_INSECURE_DEV=1

# ========== AI Service ==========
AURA_LLM_PROVIDER=mock
# Для работы с реальным LLM раскомментируйте:
# OPENAI_API_KEY=
# AURA_LLM_MODEL=gpt-4o-mini
AURA_RAG_MODE=auto

# ========== Локальный запуск без compose (make server-run / ai-run) ==========
# В compose адреса БД и AI задаются в docker-compose.yml.
# AURA_DATABASE_URL=postgresql://aura_app:<пароль>@localhost/aura
# Соединений с PostgreSQL у сервера (пул; 1–64, по умолчанию 8).
# AURA_DB_POOL_SIZE=8
# PG_URI=postgresql://postgres:<пароль>@localhost/aura
# AURA_AI_URL=http://127.0.0.1:8000
# AURA_MEMORY_BACKEND=file
# AURA_CORS_ORIGINS=http://localhost:9000

# ========== Сеть ==========
# Адрес публикации порта 9000 в compose (127.0.0.1 — только за локальным TLS-прокси)
# AURA_BIND=0.0.0.0
AURA_MAX_CONNECTIONS=1024

# ========== Почта: коды подтверждения и сброса пароля ==========
# smtp — настоящая отправка; log (по умолчанию в compose) — только запись в лог
# (без кодов); dev — код в ответе API (только локальная разработка, вместе с
# AURA_DEV_MODE=1).
AURA_MAIL_DRIVER=smtp
AURA_SMTP_HOST=smtp.example.com
# 587 + starttls (по умолчанию) или 465 + tls; none — только локальный ретранслятор
AURA_SMTP_PORT=587
AURA_SMTP_TLS=starttls
AURA_SMTP_USER=
AURA_SMTP_PASSWORD=
AURA_SMTP_FROM=Aura <no-reply@example.com>
# AURA_SMTP_CA_FILE=/etc/ssl/certs/own-ca.pem

# ========== Push-уведомления ==========
AURA_PUSH_DRIVER=dev
# Для production через webhook:
# AURA_PUSH_DRIVER=webhook
# AURA_PUSH_WEBHOOK_URL=https://push-gateway.internal/push

# ========== Google OAuth (опционально) ==========
# AURA_GOOGLE_CLIENT_ID=
# AURA_GOOGLE_CLIENT_SECRET=

# ========== Rate Limiting ==========
AURA_MAX_LOGIN_ATTEMPTS=8
AURA_LOGIN_WINDOW=300

# ========== Логи ==========
AURA_LOG_LEVEL=info

# ========== Приглашения по ссылке ==========
# Адрес веб-клиента: invite.create вернёт https://aura.example.com/#/i/<токен>.
AURA_PUBLIC_URL=

# ========== Админ-панель ==========
# Email первых администраторов через запятую. Роль admin выдаётся только
# подтверждённому адресу (при старте сервера и при входе).
AURA_ADMIN_EMAILS=

# ========== Обратный прокси ==========
# IP TLS-прокси через запятую: от них адрес клиента берётся из X-Forwarded-For.
# AURA_TRUSTED_PROXIES=172.18.0.1

# E2E-сценарий админ-панели (tools/e2e.py): тот же адрес должен быть в AURA_ADMIN_EMAILS.
# AURA_E2E_ADMIN_EMAIL=
# AURA_E2E_ADMIN_PASSWORD=

# ========== E2E тесты (моки для CI) ==========
# AURA_E2E_GOOGLE_MOCK=1
# AURA_E2E_PUSH_MOCK=1
